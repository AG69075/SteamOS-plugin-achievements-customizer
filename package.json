{
  "name": "achievement-customizer",
  "version": "1.4.1",
  "description": "Decky Loader plugin that turns Steam Deck achievement notifications into themed, console-style animated toasts.",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "format": "prettier --write src rollup.config.js",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AG69075/SteamOS-plugin-achievements-customizer.git"
  },
  "keywords": [
    "decky",
    "plugin",
    "steam-deck",
    "deck"
  ],
  "author": "bloodshine",
  "license": "BSD-3-Clause",
  "bugs": {
    "url": "https://github.com/AG69075/SteamOS-plugin-achievements-customizer/issues"
  },
  "homepage": "https://github.com/AG69075/SteamOS-plugin-achievements-customizer#readme",
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.11.6",
    "@rollup/rollup-linux-x64-musl": "^4.53.3",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "@types/webpack": "^5.28.5",
    "prettier": "3.9.10",
    "rollup": "^4.53.3",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "tslib": "^2.7.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  }
}
